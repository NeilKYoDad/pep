@{
    ViewData["Title"] = "Survey";
    Layout = "_Layout";
}

<div class="container">
    <h1>@ViewBag.SurveyName</h1>
    @if (!string.IsNullOrEmpty(ViewBag.SurveyDescription))
    {
        <p>@ViewBag.SurveyDescription</p>
    }

    <div id="formio"></div>
</div>

@section Scripts {
    <script>
        const surveyGuid = '@ViewBag.SurveyGuid';
        const surveySchema = @Html.Raw(ViewBag.SurveySchema);

        document.addEventListener('DOMContentLoaded', function() {
            if (surveySchema) {
                Formio.createForm(document.getElementById('formio'), surveySchema).then(function(form) {
                    form.on('submit', function(submission) {
                        fetch(`/survey/${surveyGuid}/submit`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ submission: JSON.stringify(submission.data) })
                        }).then(response => {
                            if (response.ok) {
                                alert('Survey submitted successfully!');
                            } else {
                                alert('Failed to submit survey.');
                            }
                        }).catch(error => {
                            console.error('Error:', error);
                            alert('An error occurred while submitting the survey.');
                        });
                    });
                });
            } else {
                document.getElementById('formio').innerHTML = '<p>Survey schema not available.</p>';
            }
        });
    </script>
}